// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ExternalIdentityProvider {
  MICROSOFT_ENTRA_ID
  GOOGLE
  LOCAL
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
}

enum CustomerContactRole {
  PRIMARY
  BILLING
  TECHNICAL
  OTHER
}

enum AddressType {
  PRIMARY
  BILLING
  SHIPPING
  PROJECT_SITE
  OTHER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskAssignmentRole {
  RESPONSIBLE
  COLLABORATOR
}

enum NoteType {
  GENERAL
  PHONE
  MEETING
  INTERNAL
  DECISION
}

enum DocumentType {
  GENERAL
  OFFER
  PRICE_LIST
  DATASHEET
  DRAWING
  PLAN
  PHOTO
  SPECIFICATION
  PROTOCOL
  OTHER
}

enum ActivityType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  PROJECT_ARCHIVED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_CANCELLED
  TASK_ARCHIVED
  NOTE_CREATED
  DOCUMENT_CREATED
  DOCUMENT_VERSION_ADDED
  DOCUMENT_ARCHIVED
  CALENDAR_EVENT_CREATED
  CALENDAR_EVENT_UPDATED
  CALENDAR_EVENT_CANCELLED
  DUNNING_SENT
  PAYMENT_RECORDED
  CREDIT_NOTE_CREATED
  QUOTE_CREATED
  QUOTE_STATUS_CHANGED
  INVOICE_CREATED
  INVOICE_STATUS_CHANGED
}

enum InboundEmailStatus {
  NEW
  DONE
  IGNORED
}

enum AiProposalStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum AiProposalSource {
  CHAT
  AGENT
}

enum ReservationStatus {
  TENTATIVE
  CONFIRMED
  RETURNED
  CANCELLED
}

enum SupplierInvoiceStatus {
  OPEN
  PAID
  DISPUTED
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesDocumentType {
  QUOTE
  INVOICE
  CREDIT_NOTE
}

enum SalesDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  PAID
  CANCELLED
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Density {
  COMPACT
  COMFORTABLE
}

enum TaskView {
  LIST
  KANBAN
}

enum CalendarViewSetting {
  AGENDA
  MONTH
  WEEK
}

enum LandingPage {
  DASHBOARD
  TASKS
  CALENDAR
  PROJECTS
}

model Organization {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  slug              String               @unique
  status            OrganizationStatus   @default(ACTIVE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  archivedAt        DateTime?
  members           OrganizationMember[]
  customers         Customer[]
  contacts          Contact[]
  addresses         Address[]
  projects          Project[]
  tasks             Task[]
  documents         Document[]
  calendarEvents    CalendarEvent[]
  articles          Article[]
  salesDocuments    SalesDocument[]
  numberSequences   NumberSequence[]
  companyProfile    CompanyProfile?
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  aiProposals       AiProposal[]
  inboundEmails     InboundEmail[]
  reservations      Reservation[]
  supplierInvoices  SupplierInvoice[]
  bankTransactions  BankTransaction[]
  timeEntries       TimeEntry[]
  recurringInvoices RecurringInvoice[]

  @@map("organizations")
}

model User {
  id                       String                 @id @default(uuid()) @db.Uuid
  email                    String                 @unique
  displayName              String
  passwordHash             String?
  /// Bumped to invalidate every JWT issued before (lock, password change/reset).
  tokenVersion             Int                    @default(0)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  archivedAt               DateTime?
  externalIdentities       ExternalIdentity[]
  organizationRoles        OrganizationMember[]
  projectMemberships       ProjectMember[]
  taskAssignments          TaskAssignment[]
  tasksCreated             Task[]                 @relation("TaskCreator")
  notesAuthored            Note[]
  documentsAuthored        Document[]
  documentVersionsUploaded DocumentVersion[]
  activitiesLogged         Activity[]             @relation("ActivityActor")
  salesDocumentsCreated    SalesDocument[]        @relation("SalesDocumentCreator")
  timeEntries              TimeEntry[]            @relation("TimeEntryUser")
  statusChanges            ProjectStatusHistory[]
  passwordResetTokens      PasswordResetToken[]
  sessions                 UserSession[]
  calendarEventsCreated    CalendarEvent[]
  reminders                Reminder[]
  notifications            Notification[]
  userSetting              UserSetting?

  @@map("users")
}

model UserSetting {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @unique @db.Uuid
  theme                Theme               @default(SYSTEM)
  density              Density             @default(COMFORTABLE)
  defaultTaskView      TaskView            @default(LIST)
  showCompletedTasks   Boolean             @default(true)
  calendarDefaultView  CalendarViewSetting @default(AGENDA)
  defaultLandingPage   LandingPage         @default(DASHBOARD)
  notificationsEnabled Boolean             @default(true)
  taskReminders        Boolean             @default(true)
  calendarReminders    Boolean             @default(true)
  overdueTaskAlerts    Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// One row per browser login. The cookie carries a signed JWT whose `jti` is
/// the session secret; only its SHA-256 hash is stored here.
model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  secretHash String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// One row per scheduled background job: cluster-wide lease (lockedUntil,
/// lockedBy) plus the outcome of the last run for monitoring.
model BackgroundJobRun {
  name                String    @id
  lockedUntil         DateTime?
  lockedBy            String?
  /// Random per run; only the holder of this token may renew or finish the lease.
  runToken            String?
  /// Incremented on every acquisition (fencing counter, visible in logs).
  fence               Int       @default(0)
  lastHeartbeatAt     DateTime?
  lastStartedAt       DateTime?
  lastFinishedAt      DateTime?
  lastSucceededAt     DateTime?
  lastStatus          String?
  lastError           String?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @default(now())

  @@map("background_job_runs")
}

model ExternalIdentity {
  id         String                   @id @default(uuid()) @db.Uuid
  userId     String                   @db.Uuid
  provider   ExternalIdentityProvider
  externalId String
  createdAt  DateTime                 @default(now())
  user       User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@unique([userId, provider])
  @@map("external_identities")
}

model OrganizationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  role           OrganizationMemberRole
  joinedAt       DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Customer {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  name              String
  customerNumber    String
  website           String?
  status            CustomerStatus     @default(ACTIVE)
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts          Contact[]
  notesGeneric      Note[]
  activities        Activity[]
  documents         Document[]
  addresses         CustomerAddress[]
  projects          Project[]
  calendarEvents    CalendarEvent[]
  salesDocuments    SalesDocument[]
  inboundEmails     InboundEmail[]
  reservations      Reservation[]
  timeEntries       TimeEntry[]
  recurringInvoices RecurringInvoice[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId, name])
  @@index([organizationId, archivedAt])
  @@map("customers")
}

model Contact {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  customerId     String           @db.Uuid
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectLinks   ProjectContact[]

  @@index([customerId])
  @@index([organizationId, fullName])
  @@index([organizationId, archivedAt])
  @@map("contacts")
}

model Address {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  label          String?
  street         String?
  postalCode     String?
  city           String?
  country        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customers      CustomerAddress[]
  projects       ProjectAddress[]

  @@index([organizationId, city])
  @@index([organizationId, archivedAt])
  @@map("addresses")
}

model CustomerAddress {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @db.Uuid
  addressId  String      @db.Uuid
  type       AddressType @default(PRIMARY)
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address    Address     @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@unique([customerId, addressId])
  @@map("customer_addresses")
}

model Project {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @db.Uuid
  customerId        String                 @db.Uuid
  name              String
  projectNumber     String
  status            ProjectStatus          @default(PLANNED)
  priority          ProjectPriority        @default(MEDIUM)
  description       String?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer          Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  members           ProjectMember[]
  contacts          ProjectContact[]
  addresses         ProjectAddress[]
  tasks             Task[]
  notes             Note[]
  activities        Activity[]
  documents         Document[]
  statusHistory     ProjectStatusHistory[]
  calendarEvents    CalendarEvent[]
  salesDocuments    SalesDocument[]
  reservations      Reservation[]
  timeEntries       TimeEntry[]
  recurringInvoices RecurringInvoice[]
  purchaseOrders    PurchaseOrder[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([customerId])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole @default(CONTRIBUTOR)
  joinedAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectContact {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  contactId String   @db.Uuid
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([projectId, contactId])
  @@map("project_contacts")
}

model ProjectAddress {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  addressId String      @db.Uuid
  type      AddressType @default(PROJECT_SITE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  address   Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)

  @@unique([projectId, addressId])
  @@map("project_addresses")
}

model Task {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  projectId       String?          @db.Uuid
  createdByUserId String           @db.Uuid
  title           String
  description     String?
  status          TaskStatus       @default(OPEN)
  priority        TaskPriority     @default(MEDIUM)
  statusNote      String?
  startAt         DateTime?
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments     TaskAssignment[]
  notes           Note[]
  activities      Activity[]

  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@map("tasks")
}

model TaskAssignment {
  id         String             @id @default(uuid()) @db.Uuid
  taskId     String             @db.Uuid
  userId     String             @db.Uuid
  role       TaskAssignmentRole @default(RESPONSIBLE)
  assignedAt DateTime           @default(now())
  task       Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @db.Uuid
  projectId  String?   @db.Uuid
  taskId     String?   @db.Uuid
  authorId   String    @db.Uuid
  type       NoteType  @default(GENERAL)
  title      String?
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([customerId, archivedAt])
  @@index([projectId, archivedAt])
  @@map("notes")
}

model Document {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  customerId       String?           @db.Uuid
  projectId        String?           @db.Uuid
  authorId         String            @db.Uuid
  title            String
  type             DocumentType      @default(GENERAL)
  tags             String[]          @default([])
  currentVersionId String?           @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author           User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  currentVersion   DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[] @relation("DocumentVersions")

  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, archivedAt])
  @@map("documents")
}

model DocumentVersion {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  versionNumber Int
  storageKey    String
  fileName      String
  mimeType      String
  sizeBytes     Int
  extractedText String?
  uploadedById  String    @db.Uuid
  createdAt     DateTime  @default(now())
  document      Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  currentFor    Document? @relation("CurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String?      @db.Uuid
  projectId   String?      @db.Uuid
  taskId      String?      @db.Uuid
  actorUserId String?      @db.Uuid
  type        ActivityType
  message     String
  occurredAt  DateTime     @default(now())
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor       User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([taskId, occurredAt])
  @@map("activities")
}

model ProjectStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  changedById String?        @db.Uuid
  fromStatus  ProjectStatus?
  toStatus    ProjectStatus
  changedAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  changedBy   User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId, changedAt])
  @@map("project_status_history")
}

model CalendarEvent {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  createdByUserId String              @db.Uuid
  customerId      String?             @db.Uuid
  projectId       String?             @db.Uuid
  title           String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean             @default(false)
  status          CalendarEventStatus @default(SCHEDULED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  archivedAt      DateTime?
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reminders       Reminder[]

  @@index([organizationId, startsAt])
  @@index([customerId, startsAt])
  @@index([projectId, startsAt])
  @@index([organizationId, archivedAt])
  @@map("calendar_events")
}

model Reminder {
  id              String         @id @default(uuid()) @db.Uuid
  calendarEventId String         @db.Uuid
  userId          String         @db.Uuid
  remindAt        DateTime
  status          ReminderStatus @default(PENDING)
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  calendarEvent   CalendarEvent  @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification    Notification?

  @@index([status, remindAt])
  @@index([calendarEventId])
  @@map("reminders")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  title      String
  message    String
  readAt     DateTime?
  reminderId String?   @unique @db.Uuid
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder   Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Article {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  articleNumber    String
  name             String
  description      String?
  unit             String              @default("Stk")
  unitPriceCents   Int
  vatRateBp        Int                 @default(1900)
  trackStock       Boolean             @default(false)
  stockQuantity    Int                 @default(0)
  minStock         Int                 @default(0)
  isRentable       Boolean             @default(false)
  rentalStock      Int                 @default(0)
  rentalPriceCents Int                 @default(0)
  reservations     Reservation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  archivedAt       DateTime?
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items            SalesDocumentItem[]
  purchaseItems    PurchaseOrderItem[]

  @@unique([organizationId, articleNumber])
  @@index([organizationId, archivedAt])
  @@index([organizationId, name])
  @@map("articles")
}

model NumberSequence {
  organizationId String       @db.Uuid
  key            String
  lastValue      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key])
  @@map("number_sequences")
}

model SalesDocument {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  type               SalesDocumentType
  number             String
  status             SalesDocumentStatus @default(DRAFT)
  customerId         String              @db.Uuid
  projectId          String?             @db.Uuid
  sourceQuoteId      String?             @db.Uuid
  creditedInvoiceId  String?             @db.Uuid
  creditedCents      Int                 @default(0)
  issueDate          DateTime            @db.Date
  dueDate            DateTime?           @db.Date
  headerText         String?
  footerText         String?
  netCents           Int                 @default(0)
  vatCents           Int                 @default(0)
  grossCents         Int                 @default(0)
  createdById        String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paidAt             DateTime?
  paidCents          Int                 @default(0)
  dunningLevel       Int                 @default(0)
  lastDunnedAt       DateTime?
  payments           Payment[]
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceQuote        SalesDocument?      @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id], onDelete: Restrict)
  invoices           SalesDocument[]     @relation("QuoteToInvoice")
  creditedInvoice    SalesDocument?      @relation("InvoiceCredits", fields: [creditedInvoiceId], references: [id], onDelete: Restrict)
  creditNotes        SalesDocument[]     @relation("InvoiceCredits")
  timeEntries        TimeEntry[]
  bankTransactions   BankTransaction[]
  createdBy          User?               @relation("SalesDocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items              SalesDocumentItem[]

  @@unique([organizationId, number])
  @@index([organizationId, type, status])
  @@index([organizationId, type, issueDate])
  @@index([customerId])
  @@index([projectId])
  @@map("sales_documents")
}

model SalesDocumentItem {
  id              String        @id @default(uuid()) @db.Uuid
  salesDocumentId String        @db.Uuid
  position        Int
  articleId       String?       @db.Uuid
  description     String
  quantity        Decimal       @db.Decimal(12, 3)
  unit            String        @default("Stk")
  unitPriceCents  Int
  vatRateBp       Int           @default(1900)
  netCents        Int
  salesDocument   SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  article         Article?      @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([salesDocumentId, position])
  @@index([articleId])
  @@map("sales_document_items")
}

model CompanyProfile {
  organizationId         String       @id @db.Uuid
  legalName              String
  street                 String?
  postalCode             String?
  city                   String?
  country                String?      @default("Deutschland")
  email                  String?
  phone                  String?
  website                String?
  vatId                  String?
  taxNumber              String?
  bankName               String?
  iban                   String?
  bic                    String?
  defaultPaymentTermDays Int          @default(14)
  defaultHourlyRateCents Int          @default(0)
  invoiceFooter          String?
  updatedAt              DateTime     @updatedAt
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  salesDocumentId String        @db.Uuid
  amountCents     Int
  paidAt          DateTime      @db.Date
  method          String?
  note            String?
  createdById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  salesDocument   SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Restrict)

  @@index([salesDocumentId])
  @@index([paidAt])
  @@map("payments")
}

model Supplier {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  supplierNumber String
  name           String
  email          String?
  phone          String?
  street         String?
  postalCode     String?
  city           String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]

  @@unique([organizationId, supplierNumber])
  @@index([organizationId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  supplierId       String              @db.Uuid
  projectId        String?             @db.Uuid
  number           String
  status           PurchaseOrderStatus @default(DRAFT)
  orderDate        DateTime            @db.Date
  expectedDate     DateTime?           @db.Date
  notes            String?
  netCents         Int                 @default(0)
  createdById      String?             @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items            PurchaseOrderItem[]
  supplierInvoices SupplierInvoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([projectId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid()) @db.Uuid
  purchaseOrderId  String        @db.Uuid
  position         Int
  articleId        String?       @db.Uuid
  description      String
  quantity         Int
  receivedQuantity Int           @default(0)
  unit             String        @default("Stk")
  unitPriceCents   Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  article          Article?      @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([purchaseOrderId, position])
  @@map("purchase_order_items")
}

model AiProposal {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  source         AiProposalSource
  kind           String
  title          String
  summary        String?
  payload        Json
  status         AiProposalStatus @default(PENDING)
  result         Json?
  error          String?
  dedupeKey      String?
  requestedById  String?          @db.Uuid
  decidedById    String?          @db.Uuid
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, createdAt])
  @@map("ai_proposals")
}

model InboundEmail {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  messageId      String
  fromAddress    String
  fromName       String?
  subject        String
  textBody       String
  receivedAt     DateTime
  customerId     String?            @db.Uuid
  status         InboundEmailStatus @default(NEW)
  category       String?
  aiSummary      String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, messageId])
  @@index([organizationId, status, receivedAt])
  @@index([customerId])
  @@map("inbound_emails")
}

model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  articleId      String            @db.Uuid
  customerId     String?           @db.Uuid
  projectId      String?           @db.Uuid
  quantity       Int
  startsOn       DateTime          @db.Date
  endsOn         DateTime          @db.Date
  status         ReservationStatus @default(CONFIRMED)
  note           String?
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  article        Article           @relation(fields: [articleId], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, articleId, startsOn, endsOn])
  @@index([organizationId, status])
  @@index([projectId])
  @@map("reservations")
}

model SupplierInvoice {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  supplierId       String                @db.Uuid
  purchaseOrderId  String?               @db.Uuid
  invoiceNumber    String
  status           SupplierInvoiceStatus @default(OPEN)
  issueDate        DateTime              @db.Date
  dueDate          DateTime?             @db.Date
  netCents         Int
  vatCents         Int
  grossCents       Int
  paidAt           DateTime?             @db.Date
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier         Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder    PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]

  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@map("supplier_invoices")
}

model BankTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @db.Uuid
  bookingDate       DateTime              @db.Date
  amountCents       Int
  counterparty      String?
  purpose           String?
  importHash        String
  status            BankTransactionStatus @default(UNMATCHED)
  salesDocumentId   String?               @db.Uuid
  supplierInvoiceId String?               @db.Uuid
  createdAt         DateTime              @default(now())
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesDocument     SalesDocument?        @relation(fields: [salesDocumentId], references: [id], onDelete: SetNull)
  supplierInvoice   SupplierInvoice?      @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, importHash])
  @@index([organizationId, status, bookingDate])
  @@map("bank_transactions")
}

model TimeEntry {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  userId           String         @db.Uuid
  customerId       String?        @db.Uuid
  projectId        String?        @db.Uuid
  workDate         DateTime       @db.Date
  minutes          Int
  description      String
  billable         Boolean        @default(true)
  hourlyRateCents  Int            @default(0)
  billedDocumentId String?        @db.Uuid
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User           @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billedDocument   SalesDocument? @relation(fields: [billedDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId, workDate])
  @@index([userId, workDate])
  @@index([projectId])
  @@index([organizationId, billable, billedDocumentId])
  @@map("time_entries")
}

model RecurringInvoice {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  customerId     String          @db.Uuid
  projectId      String?         @db.Uuid
  title          String
  intervalMonths Int
  nextRunDate    DateTime        @db.Date
  active         Boolean         @default(true)
  headerText     String?
  footerText     String?
  items          Json
  lastRunAt      DateTime?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, active, nextRunDate])
  @@map("recurring_invoices")
}
