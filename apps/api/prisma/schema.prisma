// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ExternalIdentityProvider {
  MICROSOFT_ENTRA_ID
  GOOGLE
  LOCAL
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
}

enum CustomerContactRole {
  PRIMARY
  BILLING
  TECHNICAL
  OTHER
}

enum AddressType {
  PRIMARY
  BILLING
  SHIPPING
  PROJECT_SITE
  OTHER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskAssignmentRole {
  RESPONSIBLE
  COLLABORATOR
}

enum NoteType {
  GENERAL
  PHONE
  MEETING
  INTERNAL
  DECISION
}

enum DocumentType {
  GENERAL
  OFFER
  DRAWING
  PLAN
  PHOTO
  SPECIFICATION
  PROTOCOL
  OTHER
}

enum ActivityType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  PROJECT_ARCHIVED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_CANCELLED
  TASK_ARCHIVED
  NOTE_CREATED
  DOCUMENT_CREATED
  DOCUMENT_VERSION_ADDED
  DOCUMENT_ARCHIVED
}

model Organization {
  id         String               @id @default(uuid()) @db.Uuid
  name       String
  slug       String               @unique
  status     OrganizationStatus   @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  archivedAt DateTime?
  members    OrganizationMember[]
  customers  Customer[]
  contacts   Contact[]
  addresses  Address[]
  projects   Project[]
  tasks      Task[]
  documents  Document[]

  @@map("organizations")
}

model User {
  id                       String                 @id @default(uuid()) @db.Uuid
  email                    String                 @unique
  displayName              String
  passwordHash             String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  archivedAt               DateTime?
  externalIdentities       ExternalIdentity[]
  organizationRoles        OrganizationMember[]
  projectMemberships       ProjectMember[]
  taskAssignments          TaskAssignment[]
  tasksCreated             Task[]                 @relation("TaskCreator")
  notesAuthored            Note[]
  documentsAuthored        Document[]
  documentVersionsUploaded DocumentVersion[]
  activitiesLogged         Activity[]             @relation("ActivityActor")
  statusChanges            ProjectStatusHistory[]
  passwordResetTokens      PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model ExternalIdentity {
  id         String                   @id @default(uuid()) @db.Uuid
  userId     String                   @db.Uuid
  provider   ExternalIdentityProvider
  externalId String
  createdAt  DateTime                 @default(now())
  user       User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@unique([userId, provider])
  @@map("external_identities")
}

model OrganizationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  role           OrganizationMemberRole
  joinedAt       DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Customer {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String
  customerNumber String
  website        String?
  status         CustomerStatus    @default(ACTIVE)
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts       Contact[]
  notesGeneric   Note[]
  activities     Activity[]
  documents      Document[]
  addresses      CustomerAddress[]
  projects       Project[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId, name])
  @@index([organizationId, archivedAt])
  @@map("customers")
}

model Contact {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  customerId     String           @db.Uuid
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectLinks   ProjectContact[]

  @@index([customerId])
  @@index([organizationId, fullName])
  @@index([organizationId, archivedAt])
  @@map("contacts")
}

model Address {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  label          String?
  street         String?
  postalCode     String?
  city           String?
  country        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customers      CustomerAddress[]
  projects       ProjectAddress[]

  @@index([organizationId, city])
  @@index([organizationId, archivedAt])
  @@map("addresses")
}

model CustomerAddress {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @db.Uuid
  addressId  String      @db.Uuid
  type       AddressType @default(PRIMARY)
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address    Address     @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@unique([customerId, addressId])
  @@map("customer_addresses")
}

model Project {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  customerId     String                 @db.Uuid
  name           String
  projectNumber  String
  status         ProjectStatus          @default(PLANNED)
  priority       ProjectPriority        @default(MEDIUM)
  description    String?
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  archivedAt     DateTime?
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  members        ProjectMember[]
  contacts       ProjectContact[]
  addresses      ProjectAddress[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  documents      Document[]
  statusHistory  ProjectStatusHistory[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([customerId])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole @default(CONTRIBUTOR)
  joinedAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectContact {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  contactId String   @db.Uuid
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([projectId, contactId])
  @@map("project_contacts")
}

model ProjectAddress {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  addressId String      @db.Uuid
  type      AddressType @default(PROJECT_SITE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  address   Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)

  @@unique([projectId, addressId])
  @@map("project_addresses")
}

model Task {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  projectId       String           @db.Uuid
  createdByUserId String           @db.Uuid
  title           String
  description     String?
  status          TaskStatus       @default(OPEN)
  priority        TaskPriority     @default(MEDIUM)
  statusNote      String?
  startAt         DateTime?
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments     TaskAssignment[]
  notes           Note[]
  activities      Activity[]

  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@map("tasks")
}

model TaskAssignment {
  id         String             @id @default(uuid()) @db.Uuid
  taskId     String             @db.Uuid
  userId     String             @db.Uuid
  role       TaskAssignmentRole @default(RESPONSIBLE)
  assignedAt DateTime           @default(now())
  task       Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @db.Uuid
  projectId  String?   @db.Uuid
  taskId     String?   @db.Uuid
  authorId   String    @db.Uuid
  type       NoteType  @default(GENERAL)
  title      String?
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([customerId, archivedAt])
  @@index([projectId, archivedAt])
  @@map("notes")
}

model Document {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  customerId       String?           @db.Uuid
  projectId        String?           @db.Uuid
  authorId         String            @db.Uuid
  title            String
  type             DocumentType      @default(GENERAL)
  currentVersionId String?           @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author           User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  currentVersion   DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[] @relation("DocumentVersions")

  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, archivedAt])
  @@map("documents")
}

model DocumentVersion {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid
  versionNumber Int
  storageKey    String
  fileName      String
  mimeType      String
  sizeBytes     Int
  uploadedById  String    @db.Uuid
  createdAt     DateTime  @default(now())
  document      Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  currentFor    Document? @relation("CurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String?      @db.Uuid
  projectId   String?      @db.Uuid
  taskId      String?      @db.Uuid
  actorUserId String?      @db.Uuid
  type        ActivityType
  message     String
  occurredAt  DateTime     @default(now())
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor       User?        @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([taskId, occurredAt])
  @@map("activities")
}

model ProjectStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  changedById String?        @db.Uuid
  fromStatus  ProjectStatus?
  toStatus    ProjectStatus
  changedAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  changedBy   User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId, changedAt])
  @@map("project_status_history")
}
