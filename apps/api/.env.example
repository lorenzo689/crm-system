PORT=4000
DATABASE_URL=postgresql://bissinger:bissinger_dev@localhost:5432/bissinger_os
NODE_ENV=development
# At least 32 random characters outside development (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-local-development-secret-min-32
# Registration stays disabled while this is empty
REGISTRATION_CODE=
# Number of reverse proxies in front of the API (enables correct client IPs)
# TRUST_PROXY=1
WEB_ORIGIN=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Bissinger OS <noreply@bissinger-lights.de>

# Local MinIO development storage (matches infrastructure/docker/docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bissinger-os
S3_ACCESS_KEY=bissinger
S3_SECRET_KEY=bissinger_dev_secret
S3_FORCE_PATH_STYLE=true

# --- KI (Anthropic) ---
# Einziger Pflichtwert für die KI-Funktionen. Ohne Key bleibt der Rest der App voll nutzbar.
ANTHROPIC_API_KEY=
# Optional: anderes Modell (Standard: claude-opus-5-5)
# AI_MODEL=claude-sonnet-5-5
# Optional: Denktiefe low | medium | high (Standard: medium; low = schneller/günstiger)
# AI_EFFORT=medium
# Optional: automatische Ausweichmodelle bei Ablehnung abschalten
# AI_FALLBACKS=off

# --- E-Mail-Posteingang (optional, IMAP) ---
# Ungelesene Mails werden alle 5 Minuten abgerufen, Kunden zugeordnet und von der KI eingeordnet.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=info@bissinger-lights.de
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# INBOX_ORGANIZATION_SLUG=bissinger-lights
