PORT=4000
DATABASE_URL=postgresql://bissinger:bissinger_dev@localhost:5432/bissinger_os
NODE_ENV=development
# Outside development/test the API refuses to start unless JWT_SECRET is a random value of at least
# 32 characters. Generate one with: openssl rand -base64 48
# Leave it empty locally: development then generates a random secret per process
# (sessions end on every API restart). Set any value locally to keep sessions.
JWT_SECRET=
# Session lifetime in minutes (1-480, default 480 = 8 hours; never longer).
# Applies to the session cookie, its signed JWT and the server-side session row.
# JWT_EXPIRES_IN_MINUTES=480
# Accounts are created with `pnpm --filter api user-admin` (see docs/security/sprint-1-auth-hardening.md).
# There is no public registration.

# Password reset: every answer takes at least this long so existing accounts are
# not distinguishable by timing (default 1500).
# PASSWORD_RESET_MIN_RESPONSE_MS=1500

# Integration tests only (database name MUST end in _test; they wipe all tables)
# TEST_DATABASE_URL=postgresql://bissinger:bissinger_dev@localhost:5432/bissinger_os_test
# Number of reverse proxies in front of the API (enables correct client IPs)
# TRUST_PROXY=1
# Exact browser origin(s) allowed to call the API (CORS + CSRF origin check).
# Production: required, bare https origin(s), comma-separated, e.g. https://erp.example.com
# Locally keep web and API on "localhost"; 127.0.0.1 is a different site and its
# requests are rejected (and the session cookie would not be sent).
WEB_ORIGIN=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Bissinger OS <noreply@bissinger-lights.de>

# Local MinIO development storage (matches infrastructure/docker/docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bissinger-os
S3_ACCESS_KEY=bissinger
S3_SECRET_KEY=bissinger_dev_secret
S3_FORCE_PATH_STYLE=true

# --- KI (Anthropic) ---
# Einziger Pflichtwert für die KI-Funktionen. Ohne Key bleibt der Rest der App voll nutzbar.
ANTHROPIC_API_KEY=
# Optional: anderes Modell (Standard: claude-opus-5-5)
# AI_MODEL=claude-sonnet-5-5
# Optional: Denktiefe low | medium | high (Standard: medium; low = schneller/günstiger)
# AI_EFFORT=medium
# Optional: automatische Ausweichmodelle bei Ablehnung abschalten
# AI_FALLBACKS=off

# --- E-Mail-Posteingang (optional, IMAP) ---
# Ungelesene Mails werden alle 5 Minuten abgerufen, Kunden zugeordnet und von der KI eingeordnet.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=info@bissinger-lights.de
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# INBOX_ORGANIZATION_SLUG=bissinger-lights
