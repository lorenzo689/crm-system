# Copy to .env.prod (never commit it) and fill in every value.

DOMAIN=erp.example.com

POSTGRES_USER=bissinger
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=bissinger_os

# API
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Required to register users; share it only with people who should get access.
REGISTRATION_CODE=
WEB_ORIGIN=https://erp.example.com

# Outgoing mail (password reset, quotes and invoices as PDF)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bissinger OS <noreply@bissinger-lights.de>

# Document storage (S3-compatible, e.g. Azure/AWS/MinIO)
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=bissinger-os
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# AI (optional): paste the key and restart the api container
ANTHROPIC_API_KEY=

# Inbox (optional)
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
