# Copy to .env.prod (never commit it) and fill in every value.

DOMAIN=erp.example.com

POSTGRES_USER=bissinger
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=bissinger_os

# API
# Required, random, at least 32 characters: `openssl rand -base64 48`.
# The API refuses to start with a missing, short or placeholder value.
JWT_SECRET=
# Optional token lifetime in minutes (1-480, default 480 = 8 hours)
# JWT_EXPIRES_IN_MINUTES=480
# There is no self-registration. Create the first owner and further accounts with the
# user-admin CLI (docs/security/sprint-1-auth-hardening.md).
# Required: exactly https://$DOMAIN (bare origin, no trailing slash). The API
# refuses to start otherwise; session cookies and CSRF checks depend on it.
WEB_ORIGIN=https://erp.example.com

# Outgoing mail (password reset, quotes and invoices as PDF).
# SMTP_HOST and MAIL_FROM are required: the API refuses to start without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bissinger OS <noreply@bissinger-lights.de>

# Document storage (S3-compatible, e.g. Azure/AWS/MinIO)
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=bissinger-os
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# AI (optional): paste the key and restart the api container
ANTHROPIC_API_KEY=

# Inbox (optional)
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
