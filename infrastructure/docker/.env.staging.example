# Private staging configuration. Copy to .env.staging (never commit it,
# chmod 600) or let `infrastructure/scripts/staging.sh init` generate it with
# random secrets. All values below are placeholders.

COMPOSE_PROJECT_NAME=bissinger-staging

# Exact browser origin = Tailscale Serve URL of the staging host, e.g.
# https://bos-staging.tail1234.ts.net (no path, no trailing slash).
STAGING_ORIGIN=https://bos-staging.example-tailnet.ts.net
# Loopback port the reverse proxy listens on; `tailscale serve` targets it.
STAGING_PROXY_PORT=8080

POSTGRES_USER=bissinger_staging
# URL-safe random value (hex), e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=bissinger_os_staging

# `openssl rand -base64 48`; the API refuses short or placeholder values.
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=480

# Object storage (SeaweedFS S3 gateway, internal only). Three identities:
# admin (bucket init/restore), api (read/write on the bucket), backup (read).
S3_BUCKET=bissinger-os-staging
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

MAIL_FROM=Bissinger OS Staging <staging@bissinger-os.invalid>

# Maintenance jobs only. Business jobs (IMAP, AI agents, recurring invoices,
# calendar reminders) are rejected on APP_ENV=staging.
BACKGROUND_JOBS=maintenance

# Backups: directory on a different disk than the Docker volumes, and the
# PUBLIC age key file. The private key (age identity) is kept offline.
STAGING_BACKUP_DIR=/srv/bissinger-staging/backups
BACKUP_AGE_RECIPIENTS=/etc/bissinger-staging/backup-recipients.txt
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3
